<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- assign fcs_title = page_title | default: 'FireCreek Holiday Sweepstakes | Win a Year of Meat Sticks' -%}
  {%- assign fcs_desc = page_description | default: 'Win a year of FireCreek meat sticks: one 20-count caddy every month of 2027. Enter Nov 1 – Dec 20, 2026. No purchase necessary.' -%}
  <title>{{ fcs_title | escape }}</title>
  <meta name="description" content="{{ fcs_desc | strip_html | escape }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ fcs_title | escape }}">
  <meta property="og:description" content="{{ fcs_desc | strip_html | escape }}">
  <meta property="og:image" content="https:{{ 'fcs-sweeps-social.jpg' | asset_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@400;500;600;700&family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Yellowtail&display=swap">
  {{ content_for_header }}
</head>
<body>
  {{ content_for_layout }}
</body>
</html>
