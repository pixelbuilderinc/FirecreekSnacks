<style>
/* ===========================================================================
   FireCreek Snacks — Color Tokens
   Palette pulled from the brand logo (flame #F04828), the packaging system
   (per-flavor accents), and the smoke/butcher-paper environment shots.
   =========================================================================== */
:root {
  /* --- Brand core --------------------------------------------------------- */
  --flame: #F04828;          /* the logo flame — primary brand accent        */
  --flame-deep: #D23A1F;     /* pressed / hover-dark flame                    */
  --flame-bright: #FF5C36;   /* hover-light flame, glows                      */
  --ember: #C5342A;          /* deep brand red — social/hero fields          */
  --ember-deep: #A52A20;

  /* --- Ink / charcoal (warm, never pure black) ---------------------------- */
  --char-950: #14110F;
  --char-900: #1C1815;       /* the logo black — primary ink                 */
  --char-800: #2A2420;
  --char-700: #3D352F;
  --char-600: #574C44;
  --char-500: #756860;

  /* --- Butcher paper / cream surfaces ------------------------------------- */
  /* --- Surfaces (white → subtle grey; no creams/tan) ---------------------- */
  --paper: #FFFFFF;          /* white — cards & raised surfaces              */
  --cream: #FAFAF9;          /* page background — barely-there off-white      */
  --cream-deep: #F2F2F0;     /* subtle grey panel / sunk section             */
  --kraft: #E8E8E5;          /* deeper subtle grey                          */
  /* Clearer aliases for the same surface ramp */
  --surface-0: #FFFFFF;
  --surface-1: #FAFAF9;
  --surface-2: #F2F2F0;
  --surface-3: #E8E8E5;

  /* --- Smoke neutrals (near-neutral greys: borders, dividers, muted) ------ */
  --smoke-100: #EFEFEE;
  --smoke-200: #E3E3E1;
  --smoke-300: #CBCBC8;
  --smoke-400: #9B9B96;
  --smoke-500: #6E6E6A;

  /* --- Flavor accents (from the four package colorways) ------------------- */
  --flavor-original: #E0712F; /* warm orange   */
  --flavor-kicker: #2E74C2;   /* electric blue */
  --flavor-sweet-heat: #C0392B;/* bbq red      */
  --flavor-teriyaki: #7E4536; /* soy brown     */

  /* --- Functional --------------------------------------------------------- */
  --success: #4F7A3A;        /* "gluten free" green                          */
  --warning: #E0922F;
  --danger: #C0392B;
  --info: #2E74C2;

  /* =========================================================================
     SEMANTIC ALIASES — reach for these in product work, not the raw scale.
     ========================================================================= */
  --bg-base: var(--surface-1);     /* subtle off-white page background */
  --bg-raised: var(--surface-0);   /* white */
  --bg-sunken: var(--surface-2);   /* subtle grey */
  --bg-inverse: var(--ember);      /* dark-contrast field is brand red, never black */
  --bg-brand: var(--flame);
  --bg-brand-deep: var(--ember);

  --surface-card: var(--surface-0);
  --surface-card-inverse: var(--ember);

  --text-primary: var(--char-900);
  --text-secondary: var(--char-600);
  --text-muted: var(--char-500);
  --text-on-flame: #FFFFFF;
  --text-on-dark: #FFFFFF;                          /* on brand-red fields */
  --text-on-dark-muted: rgba(255, 255, 255, 0.78);
  --text-brand: var(--flame);
  --text-link: var(--flame-deep);

  --border-subtle: var(--smoke-200);
  --border-default: var(--smoke-300);
  --border-strong: var(--char-900);
  --border-brand: var(--flame);

  --accent: var(--flame);
  --accent-deep: var(--flame-deep);
  --focus-ring: color-mix(in srgb, var(--flame) 55%, transparent);
}
/* ===========================================================================
   FireCreek Snacks — Typography Tokens
   Display is condensed & loud (Anton). Eyebrows/labels are tracked-out Oswald.
   Body is Archivo. Brush script (Yellowtail) is a garnish only — never body.
   =========================================================================== */
:root {
  /* --- Families ----------------------------------------------------------- */
  --font-display: 'Anton', 'Oswald', 'Arial Narrow', sans-serif;
  --font-condensed: 'Oswald', 'Arial Narrow', sans-serif;
  --font-body: 'Archivo', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --font-script: 'Yellowtail', 'Brush Script MT', cursive;
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;

  /* --- Weights ------------------------------------------------------------ */
  --fw-regular: 400;   /* @kind other */
  --fw-medium: 500;    /* @kind other */
  --fw-semibold: 600;  /* @kind other */
  --fw-bold: 700;      /* @kind other */
  --fw-extrabold: 800; /* @kind other */

  /* --- Type scale (rem, 16px base) ---------------------------------------- */
  --text-2xs: 0.6875rem;  /* 11px */
  --text-xs: 0.75rem;     /* 12px */
  --text-sm: 0.875rem;    /* 14px */
  --text-base: 1rem;      /* 16px */
  --text-md: 1.125rem;    /* 18px */
  --text-lg: 1.375rem;    /* 22px */
  --text-xl: 1.75rem;     /* 28px */
  --text-2xl: 2.25rem;    /* 36px */
  --text-3xl: 3rem;       /* 48px */
  --text-4xl: 4rem;       /* 64px */
  --text-5xl: 5.5rem;     /* 88px */
  --text-6xl: 7.5rem;     /* 120px */

  /* --- Line heights ------------------------------------------------------- */
  --leading-none: 0.95;
  --leading-tight: 1.08;
  --leading-snug: 1.25;
  --leading-normal: 1.5;
  --leading-relaxed: 1.65;

  /* --- Letter spacing ----------------------------------------------------- */
  --tracking-tightest: -0.02em;
  --tracking-tight: -0.01em;
  --tracking-normal: 0;
  --tracking-wide: 0.04em;
  --tracking-wider: 0.08em;
  --tracking-widest: 0.16em;   /* eyebrows / overlines — Oswald uppercase    */

  /* =========================================================================
     SEMANTIC ROLES
     ========================================================================= */
  --role-display-family: var(--font-display);
  --role-display-tracking: var(--tracking-tight);
  --role-display-leading: var(--leading-none);

  --role-eyebrow-family: var(--font-condensed);
  --role-eyebrow-size: var(--text-sm);
  --role-eyebrow-weight: var(--fw-semibold);
  --role-eyebrow-tracking: var(--tracking-widest);

  --role-body-family: var(--font-body);
  --role-body-size: var(--text-base);
  --role-body-leading: var(--leading-relaxed);

  --role-script-family: var(--font-script);
}
/* ===========================================================================
   FireCreek Snacks — Spacing, Radii & Layout Tokens
   8px base grid. Radii are small & honest — this brand is built from straight
   torn-paper edges and hard slabs, not soft pills (one full-round for chips).
   =========================================================================== */
:root {
  /* --- Spacing scale (8px grid, with half-steps) -------------------------- */
  --space-0: 0;
  --space-1: 0.25rem;  /* 4px  */
  --space-2: 0.5rem;   /* 8px  */
  --space-3: 0.75rem;  /* 12px */
  --space-4: 1rem;     /* 16px */
  --space-5: 1.5rem;   /* 24px */
  --space-6: 2rem;     /* 32px */
  --space-7: 2.5rem;   /* 40px */
  --space-8: 3rem;     /* 48px */
  --space-9: 4rem;     /* 64px */
  --space-10: 5rem;    /* 80px */
  --space-12: 7.5rem;  /* 120px */

  /* --- Radii -------------------------------------------------------------- */
  --radius-none: 0;
  --radius-xs: 2px;
  --radius-sm: 4px;
  --radius-md: 6px;     /* default for cards / inputs                        */
  --radius-lg: 10px;
  --radius-full: 999px; /* chips, avatars, the rare true pill                */

  /* --- Border widths ------------------------------------------------------ */
  --border-hair: 1px;
  --border-thin: 1.5px;
  --border-bold: 2px;
  --border-chunky: 3px;  /* the brand likes a confident outline             */

  /* --- Layout ------------------------------------------------------------- */
  --container-sm: 640px;
  --container-md: 960px;
  --container-lg: 1200px;
  --container-xl: 1320px;
  --gutter: var(--space-5);
  --section-y: var(--space-10);
}
/* ===========================================================================
   FireCreek Snacks — Effects: shadows, elevation, motion, textures
   The look is print-shop, not glassmorphism: tight contact shadows, hard
   offset "stamp" shadows for the loud CTAs, snappy motion, no blur-heavy glass.
   =========================================================================== */
:root {
  /* --- Shadows ------------------------------------------------------------ */
  --shadow-xs: 0 1px 2px rgba(28, 24, 21, 0.08);
  --shadow-sm: 0 2px 6px rgba(28, 24, 21, 0.10);
  --shadow-md: 0 6px 18px rgba(28, 24, 21, 0.12);
  --shadow-lg: 0 16px 40px rgba(28, 24, 21, 0.16);
  --shadow-inset: inset 0 1px 0 rgba(255, 255, 255, 0.5);

  /* Hard "stamped" offset shadows — the signature CTA / sticker look.
     Pair with --border-strong for the printed-label feel.                    */
  --shadow-stamp: 4px 4px 0 var(--char-900);
  --shadow-stamp-sm: 3px 3px 0 var(--char-900);
  --shadow-stamp-flame: 4px 4px 0 var(--flame);

  /* --- Glow (use sparingly, around the flame mark) ------------------------ */
  --glow-flame: 0 0 24px rgba(240, 72, 40, 0.45);

  /* --- Motion ------------------------------------------------------------- */
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);          /* @kind other */
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);       /* @kind other */
  --ease-snap: cubic-bezier(0.34, 1.56, 0.64, 1);      /* @kind other */ /* tiny overshoot */
  --dur-fast: 120ms;  /* @kind other */
  --dur-base: 200ms;  /* @kind other */
  --dur-slow: 320ms;  /* @kind other */

  /* --- Z-index ------------------------------------------------------------ */
  --z-base: 0;        /* @kind other */
  --z-sticky: 100;    /* @kind other */
  --z-overlay: 800;   /* @kind other */
  --z-modal: 900;     /* @kind other */
  --z-toast: 1000;    /* @kind other */

  /* --- Textures / fills ---------------------------------------------------- */
  /* Faint kraft-paper grain you can layer behind cream surfaces.            */
  --texture-grain:
    radial-gradient(rgba(28,24,21,0.035) 1px, transparent 1px); /* @kind other */
  --texture-grain-size: 4px 4px; /* @kind other */
  /* Smoke wash for dark hero fields.                                        */
  --wash-smoke: radial-gradient(120% 80% at 50% 120%,
                rgba(255,255,255,0.10), transparent 60%); /* @kind other */
}
/* ===========================================================================
   FireCreek Snacks — Base element styles & utility roles.
   Light reset + the brand's default typographic voice on bare HTML, plus a
   handful of role classes (.fc-eyebrow, .fc-display, .fc-script) that specimen
   cards, components and kits all share.
   =========================================================================== */

*, *::before, *::after { box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; }

body {
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--text-base);
  line-height: var(--leading-relaxed);
  color: var(--text-primary);
  background: var(--bg-base);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

/* Headings default to the loud condensed display voice ---------------------- */
h1, h2, h3, h4 {
  font-family: var(--font-display);
  font-weight: 400;       /* Anton ships a single weight */
  line-height: var(--leading-none);
  letter-spacing: var(--tracking-tight);
  text-transform: uppercase;
  margin: 0 0 0.4em;
  color: var(--text-primary);
}
h1 { font-size: var(--text-4xl); }
h2 { font-size: var(--text-3xl); }
h3 { font-size: var(--text-2xl); }
h4 { font-size: var(--text-xl); }

h5, h6 {
  font-family: var(--font-condensed);
  font-weight: var(--fw-semibold);
  text-transform: uppercase;
  letter-spacing: var(--tracking-wide);
  margin: 0 0 0.5em;
}

p { margin: 0 0 1em; max-width: 68ch; text-wrap: pretty; }

a {
  color: var(--text-link);
  text-underline-offset: 2px;
  text-decoration-thickness: 1.5px;
  transition: color var(--dur-fast) var(--ease-out);
}
a:hover { color: var(--flame); }

strong, b { font-weight: var(--fw-bold); }
small { font-size: var(--text-sm); }

code, kbd, samp { font-family: var(--font-mono); font-size: 0.9em; }

hr {
  border: 0;
  border-top: var(--border-bold) solid var(--char-900);
  margin: var(--space-6) 0;
}

::selection { background: var(--flame); color: var(--paper); }

:focus-visible {
  outline: 3px solid var(--focus-ring);
  outline-offset: 2px;
}

/* --- Shared role utilities ------------------------------------------------- */
.fc-eyebrow {
  font-family: var(--font-condensed);
  font-weight: var(--fw-semibold);
  font-size: var(--text-sm);
  text-transform: uppercase;
  letter-spacing: var(--tracking-widest);
  color: var(--flame);
  display: inline-block;
}
.fc-display {
  font-family: var(--font-display);
  text-transform: uppercase;
  line-height: var(--leading-none);
  letter-spacing: var(--tracking-tight);
}
.fc-script {
  font-family: var(--font-script);
  text-transform: none;
  letter-spacing: 0;
  line-height: 1.2;
  color: var(--flame);
}
.fc-kicker-rule {
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
}
.fc-kicker-rule::before,
.fc-kicker-rule::after {
  content: "";
  height: 2px;
  width: 28px;
  background: currentColor;
}
/* ===========================================================================
   FireCreek Snacks — Design System entry point.
   =========================================================================== */

html { scroll-behavior: smooth; }
body { margin: 0; background: #FAFAF9; color: #1C1815; font-family: 'Archivo', sans-serif; }
.fcs a { color: #D23A1F; text-decoration: underline; text-underline-offset: 2px; }
.fcs a:hover { color: #F04828; }
@keyframes fcFlicker { 0%,100% { transform: scale(1) rotate(0deg); } 30% { transform: scale(1.06) rotate(-2deg); } 60% { transform: scale(0.97) rotate(1.5deg); } }
/* hover states that the design handled in script */
.fcs .fcs-btn { text-decoration: none; }
.fcs .fcs-btn:hover { color: #fff; transform: translate(-1px,-1px); box-shadow: 3px 3px 0 #1C1815; }
.fcs .fcs-btn:active { transform: translate(1px,1px); box-shadow: none; }
.fcs-nav a:hover { color: #F04828 !important; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } * { animation: none !important; } }
@media (max-width: 760px) { .fcs .fcs-hero-veil { background: rgba(255,255,255,0.9) !important; } }
@media (max-width: 900px) { .fcs .fcs-rules-aside { position: static !important; } }
@media (max-width: 760px) {
  .fcs header[style*="sticky"] > div { flex-wrap: nowrap !important; padding: 8px 16px !important; gap: 12px !important; }
  .fcs header[style*="sticky"] nav { flex-wrap: nowrap !important; gap: 14px !important; font-size: 12px !important; letter-spacing: 0.06em !important; white-space: nowrap; }
  .fcs header[style*="sticky"] nav > a[href="#flavors"], .fcs header[style*="sticky"] nav > a[href="#rules"] { display: none !important; }
  .fcs header[style*="sticky"] img { height: 40px !important; }
}
@media (max-width: 370px) {
  .fcs header[style*="sticky"] nav { gap: 10px !important; font-size: 11px !important; letter-spacing: 0.03em !important; }
  .fcs header[style*="sticky"] img { height: 34px !important; }
  .fcs header[style*="sticky"] .fcs-btn { padding: 8px 10px !important; }
}

