<script>

(function () {
  var END = Date.UTC(2026, 11, 21, 7, 59, 59); // Dec 20 2026, 11:59:59 p.m. PT
  var els = {}; ['d','h','m','s'].forEach(function (k) { els[k] = document.querySelector('[data-fcs-cd="' + k + '"]'); });
  var pad = function (n) { return String(n).padStart(2, '0'); };
  function tick() {
    var s = Math.max(0, Math.floor((END - Date.now()) / 1000));
    if (els.d) els.d.textContent = pad(Math.floor(s / 86400));
    if (els.h) els.h.textContent = pad(Math.floor(s / 3600) % 24);
    if (els.m) els.m.textContent = pad(Math.floor(s / 60) % 60);
    if (els.s) els.s.textContent = pad(s % 60);
    if (s === 0) {
      var box = document.querySelector('[data-fcs-cd="d"]');
      var wrap = box && box.closest('div[style*="gap"]');
    }
  }
  tick(); setInterval(tick, 1000);
  document.querySelectorAll('a[href^="#"]').forEach(function (a) {
    a.addEventListener('click', function (e) {
      var el = document.getElementById(a.getAttribute('href').slice(1));
      if (!el) return;
      e.preventDefault();
      window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
    });
  });
  var btn = document.getElementById('fcs-copy-addr');
  if (btn) btn.addEventListener('click', function () {
    var txt = 'FireCreek Holiday Sweepstakes, 6299 N. Eagle Road, Suite 1057, Boise ID 83713', old = btn.textContent;
    try { navigator.clipboard && navigator.clipboard.writeText(txt); } catch (e) {}
    btn.textContent = 'Address Copied';
    setTimeout(function () { btn.textContent = old; }, 1800);
  });
})();

</script>
